{
  "name": "@kopipos/api",
  "version": "0.1.0",
  "private": true,
  "description": "KopiPOS Cloud API - Backend for tenant management, licensing & sync",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.0",
    "@kopipos/shared-types": "workspace:*",
    "@kopipos/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "tsc-alias": "^1.8.0",
    "@types/node": "^22.10.0",
    "@types/bcryptjs": "^2.4.0",
    "drizzle-kit": "^0.30.0",
    "vitest": "^3.0.0",
    "rimraf": "^6.0.0",
    "dotenv": "^16.4.0"
  }
}
